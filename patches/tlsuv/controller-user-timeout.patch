+
 #include "um_debug.h"
 #include "win32_compat.h"
 #include "http_req.h"
@@ -384,6 +390,15 @@ static void tr_connect_cb(uv_os_sock_t sock, int status, void *ctx) {
     c->connect_req = NULL;
     if (status < 0) goto on_error;

+#if defined(TCP_USER_TIMEOUT)
+    // Abort the connection when sent data stays unacknowledged for 15s
+    // (black-holed path); keepalive does not fire while data is in flight.
+    {
+        unsigned int user_timeout_ms = 15000;
+        setsockopt(sock, IPPROTO_TCP, TCP_USER_TIMEOUT, (const void *) &user_timeout_ms, sizeof(user_timeout_ms));
+    }
+#endif
+
     if (c->ssl) {
         tlsuv_stream_t *s = tlsuv__calloc(1, sizeof(tlsuv_stream_t));
         tlsuv_stream_init(c->proc.loop, s, c->tls ? c->tls : get_default_tls());

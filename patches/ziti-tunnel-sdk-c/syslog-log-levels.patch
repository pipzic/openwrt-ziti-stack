+#if !defined(_WIN32)
+#include <syslog.h>
+
+// procd logs all of stderr as err; syslog keeps each line's own priority.
+static void syslog_log_writer(int level, const char *loc, const char *msg, size_t msglen) {
+    static const char *const labels[] = { "NONE", "ERROR", "WARN", "INFO", "DEBUG", "VERBOSE", "TRACE" };
+    static const int priorities[] = { LOG_ERR, LOG_ERR, LOG_WARNING, LOG_INFO, LOG_DEBUG, LOG_DEBUG, LOG_DEBUG };
+    int i = (level >= 0 && level < (int) (sizeof(labels) / sizeof(labels[0]))) ? level : 6;
+    syslog(priorities[i], "%7s %s %.*s", labels[i], loc, (int) msglen, msg);
+}
 #endif
 

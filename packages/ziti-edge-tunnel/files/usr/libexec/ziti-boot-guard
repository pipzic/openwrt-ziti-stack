#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
#
# ziti-boot-guard -- keep the router useful whatever happens to the tunnel.
#
# The tunnel always keeps running, so remote access returns as soon as the fabric
# does. When it stops carrying traffic, LAN traffic goes around it through a second
# routing table, and comes back on its own after recovery.
#
# Subcommands:
#   watchdog            Long-running loop, started by the ziti-guard service.
#   state               Print the current state as JSON.
#   probes [status-file]  Print the size of the address pool and the picks of one check.
#   identities          Print the identities and their state as JSON.
#   enroll <jwt-file>   Enroll an identity and restart the tunnel to load it.
#   identity-set <id> <0|1>   Turn an identity off or on.
#   identity-remove <id>      Delete an identity.
#   refresh-hosts       Re-resolve controller addresses into /etc/hosts.
#   setup               Create the firewall zone and apply DNS settings.
#   uninstall           Undo the bypass, DNS settings and firewall sections.

set -u

IDENT_DIR="/etc/ziti/identities"
RUNTIME="$IDENT_DIR/config.json"
HOSTS_FILE="/etc/hosts"
HOSTS_BEGIN="# BEGIN ziti-managed (ziti-boot-guard)"
HOSTS_END="# END ziti-managed (ziti-boot-guard)"
INIT="/etc/init.d/ziti-edge-tunnel"
ZET="ziti-edge-tunnel"

# Addresses for service names. dnsmasq rebind protection drops 100.64.0.0/10 answers,
# but not this range, so it can stay on. The init script passes the same range.
DNS_NET="198.18.0.0/16"
DNS_IP="198.18.0.2"

BYPASS_FILE="/var/run/ziti-bypass"
PROBE_POOL="/var/run/ziti-probe-pool"
STATE_FILE="/var/run/ziti-guard.state"
STOP_MARK="/var/run/ziti-stopped"
START_MARK="/var/run/ziti-started"
SERVICE_NAMES="/etc/ziti/service-names"
DNS_SAVED="/etc/ziti/dns.saved"
ZONE=ziti_zone
FORWARDING=ziti_lan

log() { logger -t ziti-guard "$*"; }

uci_get() { uci -q get "ziti.main.$1" 2>/dev/null; }
cfg_num() { local n; n=$(uci_get "$1"); case "$n" in ''|*[!0-9]*) echo "$2" ;; *) echo "$n" ;; esac; }
cfg_list() { local v; v=$(uci -q get "ziti.main.$1" 2>/dev/null | tr ',' ' '); echo "${v:-$2}"; }
cfg_enabled() { [ "$(uci_get watchdog_enabled)" != 0 ]; }
cfg_block() { [ "$(uci_get block_on_failure)" = 1 ]; }
cfg_wan_probes() { cfg_list watchdog_wan_probes "1.1.1.1 8.8.8.8 9.9.9.9 208.67.222.222"; }
cfg_status_timeout() { cfg_num watchdog_status_timeout 4; }
cfg_verify_url() { local u; u=$(uci_get verify_url); echo "${u:-https://api.ipify.org}"; }
cfg_fallbacks() { cfg_list dns_fallback_servers "1.1.1.1 8.8.8.8"; }

tunnel_running() { pidof ziti-edge-tunnel >/dev/null 2>&1; }
set_state() { echo "$1" > "$STATE_FILE"; }

# Run a command with output to a file, killing it after $2 seconds. This router has
# no timeout(1), and a frozen tunneler never answers its control socket.
bounded() {
	local out="$1" limit="$2" pid i=0
	shift 2
	"$@" > "$out" 2>/dev/null &
	pid=$!
	while [ "$i" -lt "$limit" ] && kill -0 "$pid" 2>/dev/null; do
		sleep 1
		i=$((i+1))
	done
	if kill -0 "$pid" 2>/dev/null; then
		kill "$pid" 2>/dev/null
		wait "$pid" 2>/dev/null
		return 1
	fi
	wait "$pid"
}

# ---- controller addresses in /etc/hosts ----
is_ipv4() { echo "$1" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$'; }

url_host() {
	echo "$1" | sed -e 's|^[a-zA-Z][a-zA-Z0-9+.-]*://||' -e 's|/.*$||' -e 's|^[^@]*@||' -e 's|:[0-9]*$||'
}

list_controllers() {
	local f url
	for f in "$IDENT_DIR"/*.json; do
		[ -e "$f" ] || continue
		[ "$f" = "$RUNTIME" ] && continue
		url=$(jsonfilter -i "$f" -e '@.ztAPI' 2>/dev/null)
		[ -n "$url" ] && echo "$url"
		jsonfilter -i "$f" -e '@.ztAPIs[*]' 2>/dev/null
	done | sort -u
}

# Ask a server directly, dnsmasq by default: /etc/hosts must not answer, and dnsmasq
# has working fallbacks.
resolve_v4() {
	local tmp
	is_ipv4 "$1" && { echo "$1"; return 0; }
	tmp=$(mktemp) || return 1
	bounded "$tmp" "$(cfg_num watchdog_dns_timeout 5)" nslookup -type=A "$1" "${2:-127.0.0.1}"
	sed -n '/^Name:/,$p' "$tmp" | awk '/^Address/ {print $NF}' \
		| grep -E '^([0-9]{1,3}\.){3}[0-9]{1,3}$'
	rm -f "$tmp"
}

strip_managed_block() {
	awk -v b="$HOSTS_BEGIN" -v e="$HOSTS_END" '
		$0==b {skip=1; next} $0==e {skip=0; next} !skip {print}' "$HOSTS_FILE"
}

# A resolution with no result keeps the old addresses: a DNS blip is not a change.
refresh_hosts() {
	local blk out url host ip
	blk=$(mktemp) && out=$(mktemp) || return 1
	list_controllers | while IFS= read -r url; do
		host=$(url_host "$url")
		[ -n "$host" ] || continue
		is_ipv4 "$host" && continue
		for ip in $(resolve_v4 "$host"); do
			printf '%s %s\n' "$ip" "$host"
		done
	done > "$blk"
	if [ -s "$blk" ]; then
		{ strip_managed_block; echo "$HOSTS_BEGIN"; cat "$blk"; echo "$HOSTS_END"; } > "$out"
		cmp -s "$out" "$HOSTS_FILE" || { cat "$out" > "$HOSTS_FILE"; log "controller addresses updated"; }
	fi
	rm -f "$blk" "$out"
}

# ---- DNS ----
# dnsmasq asks the Ziti resolver first, in strict order. strict-order waits on a
# silent server, so the resolver is listed only while the tunnel is healthy.
dns_servers_del() {
	local s
	uci -q del_list "dhcp.@dnsmasq[0].server=$DNS_IP"
	for s in $(cat "$DNS_SAVED.servers" 2>/dev/null); do
		uci -q del_list "dhcp.@dnsmasq[0].server=$s"
	done
}

dns_set_servers() {
	local want="$1" s
	dns_servers_del
	cfg_fallbacks > "$DNS_SAVED.servers"
	[ "$want" = 1 ] && uci add_list "dhcp.@dnsmasq[0].server=$DNS_IP"
	for s in $(cat "$DNS_SAVED.servers"); do
		uci add_list "dhcp.@dnsmasq[0].server=$s"
	done
	uci commit dhcp
	/etc/init.d/dnsmasq restart >/dev/null 2>&1
}

dns_save_options() {
	[ -e "$DNS_SAVED" ] && return 0
	local o v
	for o in noresolv strictorder; do
		v=$(uci -q get "dhcp.@dnsmasq[0].$o")
		echo "$o ${v:--}"
	done > "$DNS_SAVED"
	uci set dhcp.@dnsmasq[0].noresolv=1
	uci set dhcp.@dnsmasq[0].strictorder=1
}

dns_listed() { uci -q get dhcp.@dnsmasq[0].server | tr ' ' '\n' | grep -Fxq "$DNS_IP"; }

dns_sync() {
	local want="$1" have=0
	dns_save_options
	dns_listed && have=1
	if [ "$want" != "$have" ] || [ "$(cfg_fallbacks)" != "$(cat "$DNS_SAVED.servers" 2>/dev/null)" ]; then
		dns_set_servers "$want"
		log "Ziti DNS $([ "$want" = 1 ] && echo listed || echo removed)"
	fi
}

dns_restore() {
	[ -e "$DNS_SAVED" ] || return 0
	local o v
	dns_servers_del
	while read -r o v; do
		if [ "$v" = "-" ]; then uci -q delete "dhcp.@dnsmasq[0].$o"; else uci set "dhcp.@dnsmasq[0].$o=$v"; fi
	done < "$DNS_SAVED"
	uci commit dhcp
	rm -f "$DNS_SAVED" "$DNS_SAVED.servers"
	/etc/init.d/dnsmasq restart >/dev/null 2>&1
}

# ---- service names ----
# Kept on flash: blocking must still work after a reboot with a dead controller.
remember_service_names() {
	local tmp
	tmp=$(mktemp) || return 0
	jsonfilter -i "$1" -e '@.Data.Identities[*].Services[*].Addresses[@.IsHost=true].HostName' 2>/dev/null \
		| sed 's/^\*\.//' | sort -u > "$tmp"
	if cmp -s "$tmp" "$SERVICE_NAMES"; then rm -f "$tmp"; else mv "$tmp" "$SERVICE_NAMES"; fi
}

dnsmasq_conf_dir() { sed -n 's/^conf-dir=\([^,]*\).*/\1/p' /var/etc/dnsmasq.conf.* 2>/dev/null | head -n 1; }

block_names() {
	local dir file tmp
	dir=$(dnsmasq_conf_dir)
	[ -n "$dir" ] || return 0
	file="$dir/ziti-block.conf"
	tmp=$(mktemp) || return 0
	if [ "$1" = 1 ] && [ -s "$SERVICE_NAMES" ]; then
		sed 's|.*|address=/&/|' "$SERVICE_NAMES" > "$tmp"
	fi
	if [ -s "$tmp" ]; then
		cmp -s "$tmp" "$file" || { cp "$tmp" "$file"; /etc/init.d/dnsmasq restart >/dev/null 2>&1; }
	elif [ -e "$file" ]; then
		rm -f "$file"
		/etc/init.d/dnsmasq restart >/dev/null 2>&1
	fi
	rm -f "$tmp"
}

# ---- bypass: a copy of the main table without the tunnel's routes ----
# The tunneler can add routes at any time, and they stay in main, out of the way.
# A running bypass keeps the table and priority it started with, so a changed setting
# cannot strand its rule.
bypass_load() {
	if [ -s "$BYPASS_FILE" ]; then
		read -r TABLE RULE_PRIORITY < "$BYPASS_FILE"
	else
		TABLE=$(cfg_num bypass_table 1890)
		RULE_PRIORITY=$(cfg_num bypass_priority 100)
	fi
}

bypass_active() { bypass_load; ip rule show | grep -q "^$RULE_PRIORITY:"; }

bypass_fill() {
	local fam="$1" block="$2" r p
	ip "$fam" route flush table "$TABLE" 2>/dev/null
	ip "$fam" route show table main | grep -v ' dev ziti0' | grep -v linkdown | while read -r r; do
		# shellcheck disable=SC2086
		ip "$fam" route add table "$TABLE" $r 2>/dev/null
	done
	[ "$block" = 1 ] || return 0
	ip "$fam" route show table main | awk '/ dev ziti0/ {print $1}' | while read -r p; do
		case "$p" in "$DNS_NET"|198.18.*|fe80*|ff00*) continue ;; esac
		ip "$fam" route replace table "$TABLE" unreachable "$p" 2>/dev/null
	done
}

bypass_on() {
	local block=0 fam
	bypass_load
	cfg_block && block=1
	for fam in -4 -6; do
		bypass_fill "$fam" "$block"
	done
	# Addresses for service names stay on the tunnel, so its resolver can be checked.
	ip link show ziti0 >/dev/null 2>&1 && ip route replace table "$TABLE" "$DNS_NET" dev ziti0 2>/dev/null
	if ! bypass_active; then
		ip rule add priority "$RULE_PRIORITY" lookup "$TABLE"
		ip -6 rule add priority "$RULE_PRIORITY" lookup "$TABLE" 2>/dev/null
		echo "$TABLE $RULE_PRIORITY" > "$BYPASS_FILE"
		log "tunnel is out of the way: $1"
	fi
	block_names "$block"
}

bypass_off() {
	bypass_active || return 0
	ip rule del priority "$RULE_PRIORITY" lookup "$TABLE" 2>/dev/null
	ip -6 rule del priority "$RULE_PRIORITY" lookup "$TABLE" 2>/dev/null
	ip route flush table "$TABLE" 2>/dev/null
	ip -6 route flush table "$TABLE" 2>/dev/null
	rm -f "$BYPASS_FILE"
	block_names 0
	log "tunnel is back in use"
}

# ---- checks ----
# True if the Ziti resolver answers at all, a refusal included.
resolver_answers() {
	local tmp rc
	tmp=$(mktemp) || return 1
	bounded "$tmp" "$(cfg_num watchdog_dns_timeout 5)" nslookup ziti-probe.invalid "$DNS_IP"
	grep -qE "can't find|^Name:|^Address" "$tmp"
	rc=$?
	rm -f "$tmp"
	return "$rc"
}

# A subnet stands for itself by its first address: under the fabric check, a failed
# dial to it proves as much as a connection.
first_host() {
	local ip="$1" prefix="$2" last
	last=${ip##*.}
	if [ "$prefix" -lt 31 ] && [ "$last" -lt 255 ]; then
		echo "${ip%.*}.$((last + 1))"
	else
		echo "$ip"
	fi
}

# Every address worth checking, one "address port" per line, TCP only: UDP confirms
# nothing. Names stay names until picked. Parsing costs several processes per address,
# so the result is kept until the services change.
refresh_probe_pool() {
	local status="$1" sum svc low high port addr host ip prefix i
	sum=$(jsonfilter -i "$status" -e '@.Data.Identities[@.Active=true].Services[*]' 2>/dev/null | sort | md5sum)
	[ -e "$PROBE_POOL" ] && [ "$sum" = "$(cat "$PROBE_POOL.sum" 2>/dev/null)" ] && return 0
	jsonfilter -i "$status" -e '@.Data.Identities[@.Active=true].Services[*]' 2>/dev/null | while IFS= read -r svc; do
		printf '%s' "$svc" | jsonfilter -e '@.Protocols[*]' | grep -qx tcp || continue
		low=$(printf '%s' "$svc" | jsonfilter -e '@.Ports[0].Low')
		high=$(printf '%s' "$svc" | jsonfilter -e '@.Ports[0].High')
		port=$low
		[ "${low:-1}" -le 443 ] && [ "${high:-0}" -ge 443 ] && port=443
		[ -n "$port" ] || port=443
		i=0
		while addr=$(printf '%s' "$svc" | jsonfilter -e "@.Addresses[$i]" 2>/dev/null) && [ -n "$addr" ]; do
			i=$((i+1))
			host=$(printf '%s' "$addr" | jsonfilter -e '@.HostName' 2>/dev/null)
			if [ -n "$host" ]; then
				case "$host" in \**) continue ;; esac
				echo "$host $port"
				continue
			fi
			ip=$(printf '%s' "$addr" | jsonfilter -e '@.IP' 2>/dev/null)
			prefix=$(printf '%s' "$addr" | jsonfilter -e '@.Prefix' 2>/dev/null)
			is_ipv4 "$ip" && echo "$(first_host "$ip" "${prefix:-32}") $port"
		done
	done | sort -u > "$PROBE_POOL"
	echo "$sum" > "$PROBE_POOL.sum"
}

# Up to $1 random lines of stdin, a new choice on every call.
pick_random() {
	awk -v n="$1" -v seed="$(cut -d' ' -f1 /proc/uptime | tr -d .)" '
		BEGIN { srand(seed) }
		{ line[NR] = $0 }
		END {
			for (i = NR; i > 0 && n > 0; i--) {
				j = int(rand() * i) + 1
				print line[j]
				line[j] = line[i]
				n--
			}
		}'
}

explicit_targets() {
	local p
	for p in $(cfg_list watchdog_probes ""); do
		case "$p" in
			*:*) echo "${p%:*} ${p##*:}" ;;
			*)   echo "$p 443" ;;
		esac
	done
}

# Addresses for one check: the ones set by hand, or else random ones from the services.
probe_targets() {
	local count
	count=$(cfg_num watchdog_probe_count 3)
	if [ -n "$(explicit_targets)" ]; then
		explicit_targets | pick_random "$count"
	else
		pick_random "$count" < "$PROBE_POOL"
	fi
}

# The whole line: a reason can repeat word for word, and only the time tells them apart.
last_failure() { logread -e ziti-edge-tunnel -l 300 2>/dev/null | grep 'reason=' | tail -n 1; }

# The tunneler answers a TCP connect only after the fabric dial succeeds, so a connection
# proves the whole path. A refusal from the target or a service without terminators
# still proves the fabric: it carried the dial and reported back. Prints ok, alive or failed.
probe_one() {
	local ip="$1" port="$2" before after limit connected
	limit=$(cfg_num watchdog_timeout 12)
	before=$(last_failure)
	# Only the connect time matters: the service may not speak HTTP.
	connected=$(curl -s -o /dev/null --connect-timeout "$limit" -m "$limit" --interface ziti0 \
		-w '%{time_connect}' "http://$ip:$port/" 2>/dev/null)
	case "$connected" in
		''|0|0.000000) ;;
		*) echo ok; return ;;
	esac
	after=$(last_failure)
	if [ "$after" != "$before" ]; then
		case "${after#*reason=}" in
			*"error creating route"*dial*|*refused*|*terminator*) echo alive; return ;;
		esac
	fi
	echo failed
}

# The public address as seen through the tunnel. The Ziti resolver answers the name:
# dnsmasq no longer asks it during a bypass, and its other answers avoid the tunnel.
exit_ip() {
	local url host ip
	url=$(cfg_verify_url)
	host=$(url_host "$url")
	ip=$(resolve_v4 "$host" "$DNS_IP" | head -n 1)
	curl -s -m "$(cfg_num verify_timeout 8)" --interface ziti0 --connect-to "$host::${ip:-$host}:" "$url" 2>/dev/null
}

# Prints the health of the tunnel as one state word, and leaves service names cached.
tunnel_health() {
	local status dump auth=0 conn=0 targets host port limit r passed=0 strict=0 expect ip
	status=$(mktemp) && dump=$(mktemp) || { echo healthy; return; }
	limit=$(cfg_status_timeout)
	if ! bounded "$status" "$limit" "$ZET" tunnel_status || ! bounded "$dump" "$limit" "$ZET" dump; then
		rm -f "$status" "$dump"
		echo hung
		return
	fi
	# Every identity turned off: nothing is wrong, and nothing can be checked.
	if ! jsonfilter -i "$status" -e '@.Data.Identities[@.Active=true].Name' 2>/dev/null | grep -q .; then
		rm -f "$status" "$dump"
		echo no-services
		return
	fi
	grep -q 'auth_state\[FullyAuthenticated\]' "$dump" && auth=1
	grep -q 'connected\[Y\]' "$dump" && conn=1
	if [ "$auth" != 1 ] || [ "$conn" != 1 ]; then
		rm -f "$status" "$dump"
		wan_up && echo no-connection || echo no-internet
		return
	fi
	# Only an authenticated tunnel knows its services.
	if ! jsonfilter -i "$status" -e '@.Data.Identities[@.Active=true].Services[*].Name' 2>/dev/null | grep -q .; then
		rm -f "$status" "$dump"
		echo no-services
		return
	fi
	remember_service_names "$status"
	refresh_probe_pool "$status"
	rm -f "$status" "$dump"
	# Addresses set by hand stand for a resource that must work, so only a real answer counts.
	[ -n "$(explicit_targets)" ] && strict=1
	targets=$(probe_targets)
	if [ -n "$targets" ]; then
		while read -r host port; do
			ip=$(resolve_v4 "$host" "$DNS_IP" | head -n 1)
			r=failed
			[ -n "$ip" ] && r=$(probe_one "$ip" "$port")
			if [ "$r" = ok ] || { [ "$r" = alive ] && [ "$strict" = 0 ]; }; then
				passed=1
				break
			fi
		done <<-EOF
			$targets
		EOF
		if [ "$passed" = 0 ]; then
			wan_up && echo no-data || echo no-internet
			return
		fi
	fi
	expect=$(uci_get verify_expect_ip)
	if [ -n "$expect" ]; then
		[ "$(exit_ip)" = "$expect" ] || { echo no-data; return; }
	fi
	echo healthy
}

# True if a public address answers outside the tunnel.
wan_up() {
	local dev p limit
	dev=$(ip route show table main default | awk '{for (i=1;i<NF;i++) if ($i=="dev") {print $(i+1); exit}}')
	[ -n "$dev" ] || return 1
	limit=$(cfg_num watchdog_wan_timeout 4)
	for p in $(cfg_wan_probes); do
		curl -s -k -m "$limit" --interface "$dev" -o /dev/null "https://$p/" 2>/dev/null && return 0
	done
	return 1
}

in_grace() {
	local started now
	started=$(cat "$START_MARK" 2>/dev/null) || return 1
	now=$(date +%s)
	[ $((now - ${started:-0})) -lt "$(cfg_num watchdog_grace 20)" ]
}

# ---- watchdog ----
# Pauses before restarts without connection or while frozen. The last one repeats.
RESTART_STEP=0
NEXT_RESTART=0
restart_delay() {
	local i=0 d last=60
	for d in $(cfg_list watchdog_restart_delays "60 300 900 1800"); do
		case "$d" in ''|*[!0-9]*) continue ;; esac
		last=$d
		[ "$i" = "$1" ] && break
		i=$((i + 1))
	done
	echo "$last"
}

restart_due() {
	local now
	now=$(date +%s)
	[ "$NEXT_RESTART" = 0 ] && { NEXT_RESTART=$((now + $(restart_delay 0))); return 1; }
	[ "$now" -ge "$NEXT_RESTART" ] || return 1
	RESTART_STEP=$((RESTART_STEP + 1))
	NEXT_RESTART=$((now + $(restart_delay "$RESTART_STEP")))
}

restart_tunnel() {
	log "restarting the tunnel: $1"
	"$INIT" restart >/dev/null 2>&1
}

cmd_watchdog() {
	local interval fails recover health bad=0 good=0
	log "watchdog started"
	bypass_active && log "bypass was left on, keeping it until the tunnel is healthy"
	while true; do
		interval=$(cfg_num watchdog_interval 10)
		fails=$(cfg_num watchdog_fails 3)
		recover=$(cfg_num watchdog_recover 2)

		if ! tunnel_running; then
			# The tun device and its routes are gone with the process.
			bypass_off
			dns_sync 0
			RESTART_STEP=0
			NEXT_RESTART=0
			bad=0
			good=0
			if [ -z "$(list_identities)" ]; then set_state no-identities
			elif in_grace && [ ! -e "$STOP_MARK" ]; then set_state starting
			else set_state stopped; fi
		elif ! cfg_enabled; then
			bypass_off
			resolver_answers && dns_sync 1 || dns_sync 0
			set_state unchecked
		elif in_grace; then
			set_state starting
		else
			health=$(tunnel_health)
			if [ "$health" = healthy ]; then
				bad=0
				good=$((good + 1))
				RESTART_STEP=0
				NEXT_RESTART=0
				if [ "$good" -ge "$recover" ]; then
					bypass_off
					resolver_answers && dns_sync 1 || dns_sync 0
				fi
				bypass_active || set_state healthy
			else
				good=0
				bad=$((bad + 1))
				if [ "$health" = hung ] || [ "$bad" -ge "$fails" ]; then
					bypass_on "$health"
					dns_sync 0
					set_state "$health"
				fi
				case "$health" in
					no-connection)
						refresh_hosts
						restart_due && restart_tunnel "$health"
						;;
					hung)
						restart_due && restart_tunnel "$health"
						;;
				esac
			fi
			# The WAN gateway can change while the bypass is on.
			bypass_active && [ "$health" != healthy ] && bypass_on "$health"
		fi
		sleep "$interval"
	done
}

# ---- identities ----
json_str() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

# Prints a JSON array. The runtime file keeps names and on/off across stops.
identities_json() {
	local status dump f id name active st first=1 running=0 file_status ctrl block
	status=$(mktemp) && dump=$(mktemp) || { echo '[]'; return; }
	if tunnel_running; then
		running=1
		bounded "$status" "$(cfg_status_timeout)" "$ZET" tunnel_status || : > "$status"
		bounded "$dump" "$(cfg_status_timeout)" "$ZET" dump || : > "$dump"
	fi
	printf '['
	for f in "$IDENT_DIR"/*.json; do
		[ -e "$f" ] || continue
		[ "$f" = "$RUNTIME" ] && continue
		id=$(basename "$f" .json)
		file_status="$status"
		[ -s "$file_status" ] && name=$(jsonfilter -i "$file_status" -e "@.Data.Identities[@.Identifier=\"$f\"].Name" 2>/dev/null) || name=
		[ -n "$name" ] || name=$(jsonfilter -i "$RUNTIME" -e "@.Identities[@.Identifier=\"$f\"].Name" 2>/dev/null)
		active=$(jsonfilter -i "$RUNTIME" -e "@.Identities[@.Identifier=\"$f\"].Active" 2>/dev/null)
		[ -s "$file_status" ] && active=$(jsonfilter -i "$file_status" -e "@.Data.Identities[@.Identifier=\"$f\"].Active" 2>/dev/null)
		ctrl=$(jsonfilter -i "$f" -e '@.ztAPI' 2>/dev/null)
		if [ "$active" = false ]; then
			st=disabled
		elif [ "$running" != 1 ]; then
			st=stopped
		else
			# The dump holds one text block per identity, in a JSON string.
			block=$(jsonfilter -i "$dump" -e "@.Data[\"$f\"]" 2>/dev/null)
			case "$block" in
				*'auth_state[FullyAuthenticated]'*'connected[Y]'*) st=active ;;
				*) st=no-connection ;;
			esac
		fi
		[ "$first" = 1 ] || printf ','
		first=0
		printf '{"id":"%s","name":"%s","file":"%s","enabled":%s,"controller":"%s","status":"%s"}' \
			"$(json_str "$id")" "$(json_str "${name:-$id}")" "$(json_str "$f")" \
			"$([ "$active" = false ] && echo false || echo true)" "$(json_str "$ctrl")" "$st"
	done
	printf ']\n'
	rm -f "$status" "$dump"
}

list_identities() {
	local f
	for f in "$IDENT_DIR"/*.json; do
		[ -e "$f" ] && [ "$f" != "$RUNTIME" ] && echo "$f"
	done
}

valid_id() { case "$1" in *[!A-Za-z0-9_.-]*|""|config) return 1 ;; esac; }

# Why an enrollment failed, as one word. An unknown failure adds the tunneler's last line.
enroll_failure() {
	case "$(cat "$1")" in
		*ENROLLMENT_EXPIRED*) echo token-expired ;;
		*ALREADY_ENROLLED*) echo token-used ;;
		*INVALID_ENROLLMENT_TOKEN*|*"JWT not accepted"*) echo token-invalid ;;
		*"lacks a"*|*"invalid format"*|*"json parse error"*) echo token-format ;;
		*CONTROLLER_UNAVAILABLE*|*"controller is not available"*) echo no-controller ;;
		*) echo "other $(grep -v '^$' "$1" | tail -n 1 | sed 's/^([0-9]*)\[[ 0-9.]*\] *//')" ;;
	esac
}

cmd_enroll() {
	local jwt="$1" id out
	id="identity-$(date +%s)"
	out="$IDENT_DIR/$id.json"
	"$ZET" enroll --jwt "$jwt" --identity "$out" >/tmp/ziti-enroll.log 2>&1
	if [ ! -s "$out" ]; then
		rm -f "$out"
		enroll_failure /tmp/ziti-enroll.log
		rm -f /tmp/ziti-enroll.log
		return 1
	fi
	rm -f /tmp/ziti-enroll.log
	chmod 0600 "$out"
	refresh_hosts
	# The tunneler reads the identity directory only when it starts.
	"$INIT" restart >/dev/null 2>&1
	echo "$id"
}

cmd_identity_set() {
	local f on=f
	valid_id "$1" || return 2
	f="$IDENT_DIR/$1.json"
	[ -e "$f" ] || return 2
	[ "$2" = 1 ] && on=t
	"$ZET" on_off_identity -i "$f" -o "$on" >/dev/null 2>&1
}

cmd_identity_remove() {
	local f
	valid_id "$1" || return 2
	f="$IDENT_DIR/$1.json"
	[ -e "$f" ] || return 2
	tunnel_running && "$ZET" delete -i "$f" >/dev/null 2>&1
	rm -f "$f" "$f.bak"
}

# ---- install ----
zone_exists() { uci -q show firewall | grep -q "\.name='ziti'"; }

cmd_setup() {
	local changed=0
	if ! zone_exists; then
		uci set "firewall.$ZONE=zone"
		uci set "firewall.$ZONE.name=ziti"
		uci add_list "firewall.$ZONE.device=ziti0"
		uci set "firewall.$ZONE.input=REJECT"
		uci set "firewall.$ZONE.output=ACCEPT"
		uci set "firewall.$ZONE.forward=REJECT"
		uci set "firewall.$ZONE.masq=1"
		uci set "firewall.$ZONE.mtu_fix=1"
		changed=1
	fi
	if ! uci -q show firewall | grep -A1 "src='lan'" | grep -q "dest='ziti'"; then
		uci set "firewall.$FORWARDING=forwarding"
		uci set "firewall.$FORWARDING.src=lan"
		uci set "firewall.$FORWARDING.dest=ziti"
		changed=1
	fi
	if [ "$changed" = 1 ]; then
		uci commit firewall
		/etc/init.d/firewall reload >/dev/null 2>&1
	fi
	dns_sync 0
	refresh_hosts
}

cmd_uninstall() {
	local tmp
	bypass_off
	block_names 0
	dns_restore
	uci -q delete "firewall.$FORWARDING"
	uci -q delete "firewall.$ZONE"
	uci commit firewall
	/etc/init.d/firewall reload >/dev/null 2>&1
	tmp=$(mktemp) && strip_managed_block > "$tmp" && cat "$tmp" > "$HOSTS_FILE"
	rm -f "$tmp" "$SERVICE_NAMES" "$PROBE_POOL" "$PROBE_POOL.sum"
}

# For a look at what the watchdog would check. A status file stands in for the live tunnel.
cmd_probes() {
	local status="${1:-}" tmp=""
	if [ -z "$status" ]; then
		tmp=$(mktemp) || return 1
		status=$tmp
		bounded "$status" "$(cfg_status_timeout)" "$ZET" tunnel_status || { rm -f "$tmp"; return 1; }
	fi
	refresh_probe_pool "$status"
	echo "pool: $(wc -l < "$PROBE_POOL")"
	probe_targets
	[ -z "$tmp" ] || rm -f "$tmp"
}

# A check already under way may overwrite the file after Stop or Restart, so the marks win.
current_state() {
	if [ -e "$STOP_MARK" ]; then echo stopped
	elif in_grace; then echo starting
	else cat "$STATE_FILE" 2>/dev/null || echo starting; fi
}

# ---- entry point ----
case "${1:-}" in
	watchdog)        cmd_watchdog ;;
	state)           printf '{"state":"%s","bypass":%s}\n' "$(current_state)" \
	                     "$(bypass_active && echo true || echo false)" ;;
	probes)          cmd_probes "${2:-}" ;;
	identities)      identities_json ;;
	enroll)          cmd_enroll "${2:?jwt file}" ;;
	identity-set)    cmd_identity_set "${2:?id}" "${3:?0 or 1}" ;;
	identity-remove) cmd_identity_remove "${2:?id}" ;;
	refresh-hosts)   refresh_hosts ;;
	setup)           cmd_setup ;;
	uninstall)       cmd_uninstall ;;
	*) echo "usage: ziti-boot-guard {watchdog|state|probes|identities|enroll|identity-set|identity-remove|refresh-hosts|setup|uninstall}" >&2; exit 2 ;;
esac

#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
#
# ziti-boot-guard -- keep the router useful whatever happens to the tunnel.
#
# The tunnel always keeps running, so remote access returns as soon as the fabric
# does. When it stops carrying traffic, LAN traffic goes around it through a second
# routing table, and comes back on its own after recovery.
#
# Subcommands:
#   watchdog            Long-running loop, started by the ziti-guard service.
#   state               Print the current state as JSON.
#   probes [status-file]  Print the size of the address pool and the picks of one check.
#   identities          Print the identities and their state as JSON.
#   enroll <jwt-file>   Enroll an identity and restart the tunnel to load it.
#   identity-set <id> <0|1>   Turn an identity off or on.
#   identity-remove <id>      Delete an identity.
#   setup               Create the firewall zone and forwardings, apply the dnsmasq changes.
#   uninstall           Undo the bypass, the blocking rules, the dnsmasq changes and the firewall sections.

set -u

IDENT_DIR="/etc/ziti/identities"
RUNTIME="$IDENT_DIR/config.json"
INIT="/etc/init.d/ziti-edge-tunnel"
ZET="ziti-edge-tunnel"

# Addresses for service names. dnsmasq rebind protection drops 100.64.0.0/10 answers,
# but not this range, so it can stay on. The init script passes the same range.
DNS_NET="198.18.0.0/16"
DNS_IP="198.18.0.2"

BYPASS_FILE="/var/run/ziti-bypass"
BLOCK_RULES="/var/run/ziti-block-rules"
PROBE_POOL="/var/run/ziti-probe-pool"
FABRIC_NAMES="/var/run/ziti-fabric-names"
STATE_FILE="/var/run/ziti-guard.state"
STOP_MARK="/var/run/ziti-stopped"
START_MARK="/var/run/ziti-started"
SERVICE_NAMES="/etc/ziti/service-names"
SERVICE_PREFIXES="/etc/ziti/service-prefixes"
DNS_SAVED="/etc/ziti/dns.saved"
ZONE=ziti_zone
# Forwardings into the zone are named ziti_fwd_<source zone>.
FORWARDING=ziti_fwd_

log() { logger -t ziti-guard "$*"; }

uci_get() { uci -q get "ziti.main.$1" 2>/dev/null; }
cfg_num() { local n; n=$(uci_get "$1"); case "$n" in ''|*[!0-9]*) echo "$2" ;; *) echo "$n" ;; esac; }
cfg_list() { local v; v=$(uci -q get "ziti.main.$1" 2>/dev/null | tr ',' ' '); echo "${v:-$2}"; }
cfg_enabled() { [ "$(uci_get watchdog_enabled)" != 0 ]; }
cfg_block() { [ "$(uci_get block_on_failure)" = 1 ]; }
cfg_wan_probes() { cfg_list watchdog_wan_probes "1.1.1.1 8.8.8.8 9.9.9.9 208.67.222.222"; }
cfg_status_timeout() { cfg_num watchdog_status_timeout 4; }
cfg_zones() { cfg_list source_zones "lan"; }

tunnel_running() { pidof ziti-edge-tunnel >/dev/null 2>&1; }
set_state() { echo "$1" > "$STATE_FILE"; }

# Run a command with output to a file, killing it after $2 seconds. This router has
# no timeout(1), and a frozen tunneler never answers its control socket. A timer in the
# background does the killing, so a quick answer returns at once; BusyBox sleep takes
# whole seconds only. The timer takes its sleep down with it.
bounded() {
	local out="$1" limit="$2" pid timer rc
	shift 2
	"$@" > "$out" 2>/dev/null &
	pid=$!
	( trap 'kill "$s" 2>/dev/null; exit 0' TERM; sleep "$limit" & s=$!; wait "$s"; kill "$pid" 2>/dev/null ) &
	timer=$!
	wait "$pid" 2>/dev/null
	rc=$?
	kill "$timer" 2>/dev/null
	wait "$timer" 2>/dev/null
	return "$rc"
}

# ---- names ----
is_ipv4() { echo "$1" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$'; }

url_host() {
	echo "$1" | sed -e 's|^[a-zA-Z][a-zA-Z0-9+.-]*://||' -e 's|/.*$||' -e 's|^[^@]*@||' -e 's|:[0-9]*$||'
}

list_controllers() {
	local f url
	for f in "$IDENT_DIR"/*.json; do
		[ -e "$f" ] || continue
		[ "$f" = "$RUNTIME" ] && continue
		url=$(jsonfilter -i "$f" -e '@.ztAPI' 2>/dev/null)
		[ -n "$url" ] && echo "$url"
		jsonfilter -i "$f" -e '@.ztAPIs[*]' 2>/dev/null
	done | sort -u
}

# Ask one server directly, with a bounded wait.
resolve_v4() {
	local tmp
	is_ipv4 "$1" && { echo "$1"; return 0; }
	tmp=$(mktemp) || return 1
	bounded "$tmp" "$(cfg_num watchdog_dns_timeout 3)" nslookup -type=A "$1" "$2"
	sed -n '/^Name:/,$p' "$tmp" | awk '/^Address/ {print $NF}' \
		| grep -E '^([0-9]{1,3}\.){3}[0-9]{1,3}$'
	rm -f "$tmp"
}

# ---- DNS ----
# dnsmasq asks the Ziti resolver first, in strict order, and then the router's own DNS:
# the user's servers and, unless turned off, the WAN resolv file. The resolver refuses
# names that are not services, so dnsmasq moves on to the next server. strict-order
# waits on a silent server, so the resolver is listed only while the tunnel is healthy.
dns_servers() { uci -q get dhcp.@dnsmasq[0].server | tr ' ' '\n' | grep -v '^$'; }

# The resolver goes first: strict order would otherwise ask the user's servers before it.
# The rest of the list keeps its order.
dns_set_servers() {
	local want="$1" rest s
	rest=$(dns_servers | grep -Fxv "$DNS_IP")
	uci -q delete dhcp.@dnsmasq[0].server
	[ "$want" = 1 ] && uci add_list "dhcp.@dnsmasq[0].server=$DNS_IP"
	for s in $rest; do
		uci add_list "dhcp.@dnsmasq[0].server=$s"
	done
	uci commit dhcp
	/etc/init.d/dnsmasq restart >/dev/null 2>&1
}

dns_save_options() {
	[ -e "$DNS_SAVED" ] && return 0
	local v
	v=$(uci -q get dhcp.@dnsmasq[0].strictorder)
	echo "strictorder ${v:--}" > "$DNS_SAVED"
}

dns_sync() {
	local want="$1" ok=1
	[ "$(uci -q get dhcp.@dnsmasq[0].strictorder)" = 1 ] || ok=0
	dns_save_options
	if [ "$want" = 1 ]; then
		[ "$(dns_servers | head -n 1)" = "$DNS_IP" ] || ok=0
	else
		dns_servers | grep -Fxq "$DNS_IP" && ok=0
	fi
	[ "$ok" = 1 ] && return 0
	uci set dhcp.@dnsmasq[0].strictorder=1
	dns_set_servers "$want"
	log "Ziti DNS $([ "$want" = 1 ] && echo added to || echo removed from) dnsmasq"
}

dns_restore() {
	[ -e "$DNS_SAVED" ] || return 0
	local v
	uci -q del_list "dhcp.@dnsmasq[0].server=$DNS_IP"
	v=$(awk '$1 == "strictorder" {print $2}' "$DNS_SAVED")
	if [ "$v" = "-" ]; then uci -q delete dhcp.@dnsmasq[0].strictorder; elif [ -n "$v" ]; then uci set "dhcp.@dnsmasq[0].strictorder=$v"; fi
	uci commit dhcp
	rm -f "$DNS_SAVED"
	/etc/init.d/dnsmasq restart >/dev/null 2>&1
}

dnsmasq_conf_dir() { sed -n 's/^conf-dir=\([^,]*\).*/\1/p' /var/etc/dnsmasq.conf.* 2>/dev/null | head -n 1; }

# ---- names of the fabric ----
# The tunnel finds its controllers and routers through the router's DNS, every time it
# connects. A service that intercepts their names, *.org for one, would make the Ziti
# resolver answer them, and the tunnel would then reach its own fabric through itself.
# dnsmasq therefore sends these names past the resolver, to the servers the router would
# ask for them anyway.

# Controller and router URLs from the dump: the controllers learned at run time and the
# routers the tunnel connects to. Kept while the tunnel is down.
remember_fabric_names() {
	local tmp
	tmp=$(mktemp) || return 0
	grep -oE '(\]|online\[[YN]\]) https://[^ \\"]+|address\[tls://[^]]+' "$1" \
		| sed -e 's/^.* //' -e 's/^address\[//' | sort -u > "$tmp"
	if [ -s "$tmp" ] && ! cmp -s "$tmp" "$FABRIC_NAMES"; then mv "$tmp" "$FABRIC_NAMES"; else rm -f "$tmp"; fi
}

fabric_names() {
	local url host
	{ list_controllers; cat "$FABRIC_NAMES" 2>/dev/null; } | while IFS= read -r url; do
		host=$(url_host "$url")
		case "$host" in ''|*:*|\[*) continue ;; esac
		is_ipv4 "$host" || echo "$host"
	done | sort -u
}

wan_dns() {
	local f
	[ "$(uci -q get dhcp.@dnsmasq[0].noresolv)" = 1 ] && return 0
	f=$(uci -q get dhcp.@dnsmasq[0].resolvfile)
	awk '$1 == "nameserver" {print $2}' "${f:-/tmp/resolv.conf.d/resolv.conf.auto}" 2>/dev/null
}

# The servers dnsmasq would ask for a name without the Ziti resolver. As in dnsmasq, the
# most specific domain rule decides: its servers, the standard servers for #, and none for
# a rule without a server, which keeps the name local. Without a domain rule: the user's
# plain servers and the WAN resolv file. *.example.org covers only names under it.
fabric_servers() {
	local name s rule srv d sub best=0 found="" plain=""
	name=$(echo "$1" | tr 'A-Z' 'a-z')
	for s in $(dns_servers); do
		case "$s" in
			"$DNS_IP") ;;
			/*)
				rule=${s#/}
				srv=${rule##*/}
				rule=$(echo "${rule%/*}" | tr 'A-Z/' 'a-z ')
				for d in $rule; do
					sub=0
					case "$d" in '*.'*) d=${d#\*.}; sub=1 ;; .*) d=${d#.} ;; esac
					case "$name" in *".$d") ;; "$d") [ "$sub" = 0 ] || continue ;; *) continue ;; esac
					if [ "${#d}" -gt "$best" ]; then best=${#d}; found="${srv:--}"
					elif [ "${#d}" -eq "$best" ]; then found="$found ${srv:--}"; fi
				done
				;;
			*) plain="$plain $s" ;;
		esac
	done
	# shellcheck disable=SC2046,SC2086
	if [ "$best" = 0 ]; then
		printf '%s\n' $plain $(wan_dns)
	else
		for s in $found; do
			case "$s" in '#') printf '%s\n' $plain $(wan_dns) ;; -) ;; *) echo "$s" ;; esac
		done
	fi | awk 'NF && !seen[$0]++'
}

# Rewritten only on a change: new DNS on the router, a new controller or router.
# With no server known, no rule is better than a wrong one.
fabric_dns_sync() {
	local dir file tmp name s
	dir=$(dnsmasq_conf_dir)
	[ -n "$dir" ] || return 0
	file="$dir/ziti-fabric.conf"
	tmp=$(mktemp) || return 0
	fabric_names | while IFS= read -r name; do
		for s in $(fabric_servers "$name"); do
			echo "server=/$name/$s"
		done
	done > "$tmp"
	if [ -s "$tmp" ]; then
		if ! cmp -s "$tmp" "$file"; then
			cp "$tmp" "$file"
			/etc/init.d/dnsmasq restart >/dev/null 2>&1
			log "updated DNS rules for controller and router names: $(wc -l < "$tmp")"
		fi
	elif [ -e "$file" ]; then
		rm -f "$file"
		/etc/init.d/dnsmasq restart >/dev/null 2>&1
	fi
	rm -f "$tmp"
}

fabric_dns_off() {
	local dir
	dir=$(dnsmasq_conf_dir)
	[ -n "$dir" ] && [ -e "$dir/ziti-fabric.conf" ] || return 0
	rm -f "$dir/ziti-fabric.conf"
	/etc/init.d/dnsmasq restart >/dev/null 2>&1
}

# ---- service names ----
# Kept on flash: blocking must still work after a reboot with a dead controller.
remember_service_names() {
	local tmp
	tmp=$(mktemp) || return 0
	jsonfilter -i "$1" -e '@.Data.Identities[*].Services[*].Addresses[@.IsHost=true].HostName' 2>/dev/null \
		| sed 's/^\*\.//' | sort -u > "$tmp"
	if cmp -s "$tmp" "$SERVICE_NAMES"; then rm -f "$tmp"; else mv "$tmp" "$SERVICE_NAMES"; fi
}

# The tunnel's routes are gone as soon as its process is, so blocking works from a copy.
# Kept on flash for the same reason as the names. Written only while routes exist.
remember_service_prefixes() {
	local tmp fam p
	tmp=$(mktemp) || return 0
	for fam in -4 -6; do
		ip "$fam" route show table main | awk '/ dev ziti0/ {print $1}' | while read -r p; do
			case "$p" in "$DNS_NET"|198.18.*|fe80*|ff00*) continue ;; esac
			echo "$fam $p"
		done
	done | sort -u > "$tmp"
	if [ ! -s "$tmp" ] || cmp -s "$tmp" "$SERVICE_PREFIXES"; then rm -f "$tmp"; else mv "$tmp" "$SERVICE_PREFIXES"; fi
}

block_names() {
	local dir file tmp
	dir=$(dnsmasq_conf_dir)
	[ -n "$dir" ] || return 0
	file="$dir/ziti-block.conf"
	tmp=$(mktemp) || return 0
	if [ "$1" = 1 ] && [ -s "$SERVICE_NAMES" ]; then
		sed 's|.*|address=/&/|' "$SERVICE_NAMES" > "$tmp"
	fi
	if [ -s "$tmp" ]; then
		cmp -s "$tmp" "$file" || { cp "$tmp" "$file"; /etc/init.d/dnsmasq restart >/dev/null 2>&1; }
	elif [ -e "$file" ]; then
		rm -f "$file"
		/etc/init.d/dnsmasq restart >/dev/null 2>&1
	fi
	rm -f "$tmp"
}

# ---- bypass: a copy of the main table without the tunnel's routes ----
# The tunneler can add routes at any time, and they stay in main, out of the way.
# A running bypass keeps the table and priority it started with, so a changed setting
# cannot strand its rule.
bypass_load() {
	if [ -s "$BYPASS_FILE" ]; then
		read -r TABLE RULE_PRIORITY < "$BYPASS_FILE"
	else
		TABLE=$(cfg_num bypass_table 1890)
		RULE_PRIORITY=$(cfg_num bypass_priority 100)
	fi
}

bypass_rule() { ip "$1" rule show 2>/dev/null | grep -Eq "^$RULE_PRIORITY:.*lookup $TABLE( |\$)"; }
bypass_active() { bypass_load; bypass_rule -4 || bypass_rule -6; }

# The main table without its expiry counters, which change on every look.
bypass_source() { ip "$1" route show table main | sed 's/ expires [0-9]*sec//'; }

bypass_fill() {
	local fam="$1" block="$2" r p
	ip "$fam" route flush table "$TABLE" 2>/dev/null
	ip "$fam" route show table main | grep -v ' dev ziti0' | grep -v linkdown | while read -r r; do
		# shellcheck disable=SC2086
		ip "$fam" route add table "$TABLE" $r 2>/dev/null
	done
	[ "$block" = 1 ] || return 0
	awk -v f="$fam" '$1 == f {print $2}' "$SERVICE_PREFIXES" 2>/dev/null | while read -r p; do
		ip "$fam" route replace table "$TABLE" unreachable "$p" 2>/dev/null
	done
}

# Called on every check while the bypass is on. The table is refilled only when the main
# table changes: a refill empties it for a moment, and traffic would fall through to main.
bypass_on() {
	local block=0 fam sum
	bypass_load
	cfg_block && block=1
	remember_service_prefixes
	sum=$({ bypass_source -4; bypass_source -6; echo "$block"; cat "$SERVICE_PREFIXES" 2>/dev/null; } | md5sum)
	if ! bypass_active || [ "$sum" != "$(cat "$BYPASS_FILE.sum" 2>/dev/null)" ]; then
		for fam in -4 -6; do
			bypass_fill "$fam" "$block"
		done
		echo "$sum" > "$BYPASS_FILE.sum"
	fi
	# Addresses for service names stay on the tunnel, so its resolver can be checked.
	ip link show ziti0 >/dev/null 2>&1 && ip route replace table "$TABLE" "$DNS_NET" dev ziti0 2>/dev/null
	if ! bypass_active; then
		# The watchdog's own checks bind to ziti0 and skip the table, whose blocking routes
		# would otherwise refuse them, and the tunnel could never be seen to recover.
		for fam in -4 -6; do
			ip "$fam" rule add priority "$RULE_PRIORITY" oif ziti0 lookup main 2>/dev/null
			ip "$fam" rule add priority "$RULE_PRIORITY" lookup "$TABLE" 2>/dev/null
		done
		echo "$TABLE $RULE_PRIORITY" > "$BYPASS_FILE"
		log "bypass on: $1"
	fi
	block_names "$block"
}

bypass_off() {
	local fam
	bypass_active || return 0
	for fam in -4 -6; do
		ip "$fam" rule del priority "$RULE_PRIORITY" oif ziti0 lookup main 2>/dev/null
		ip "$fam" rule del priority "$RULE_PRIORITY" lookup "$TABLE" 2>/dev/null
		ip "$fam" route flush table "$TABLE" 2>/dev/null
	done
	rm -f "$BYPASS_FILE" "$BYPASS_FILE.sum"
	block_names 0
	log "bypass off"
}

# ---- blocking before the next check ----
# Once installed, these rules prevent source-zone traffic from falling back to less
# specific routes when the tunnel exits. Each device and cached non-default service
# prefix gets a pair, plus one for DNS_NET. Main is used only for a route at least as
# specific as the protected prefix; otherwise traffic is rejected. Routes outside the
# tunnel can also qualify. Locally generated traffic is not matched. The rules follow
# the bypass priority, so bypass takes over once the watchdog enables it.
block_rules_want() {
	local prio z dev fam p len
	cfg_enabled && cfg_block && tunnel_wanted && [ -s "$SERVICE_PREFIXES" ] || return 0
	prio=$(cfg_num bypass_priority 100)
	for z in $(cfg_zones); do
		case "$z" in ziti|*[!A-Za-z0-9_]*) continue ;; esac
		fw4 -q zone "$z" 2>/dev/null
	done | sort -u | while read -r dev; do
		case "$dev" in ''|*[!A-Za-z0-9_.@-]*) continue ;; esac
		{ cat "$SERVICE_PREFIXES"; echo "-4 $DNS_NET"; } | while read -r fam p; do
			case "$p" in
				default) continue ;;
				*/*) len=${p##*/} ;;
				*) if [ "$fam" = -6 ]; then len=128; else len=32; fi ;;
			esac
			case "$len" in ''|*[!0-9]*|0) continue ;; esac
			echo "$fam $((prio + 1)) iif $dev to $p lookup main suppress_prefixlength $((len - 1))"
			echo "$fam $((prio + 2)) iif $dev to $p unreachable"
		done
	done
}

# Reads "family priority selector..." lines.
block_rules_apply() {
	local fam prio sel
	while read -r fam prio sel; do
		# shellcheck disable=SC2086
		ip "$fam" rule "$1" priority "$prio" $sel 2>/dev/null
	done
}

# Replace the rules only when the desired list changes: cached prefixes, zone devices,
# settings, or whether the tunnel is wanted.
block_rules_sync() {
	local tmp
	tmp=$(mktemp) || return 0
	block_rules_want > "$tmp"
	if cmp -s "$tmp" "$BLOCK_RULES" || { [ ! -s "$tmp" ] && [ ! -e "$BLOCK_RULES" ]; }; then
		rm -f "$tmp"
		return 0
	fi
	[ -e "$BLOCK_RULES" ] && block_rules_apply del < "$BLOCK_RULES"
	if [ -s "$tmp" ]; then
		block_rules_apply add < "$tmp"
		mv "$tmp" "$BLOCK_RULES"
		log "early blocking on: $(awk '/unreachable/ {print $6}' "$BLOCK_RULES" | sort -u | tr '\n' ' ')"
	else
		rm -f "$tmp" "$BLOCK_RULES"
		log "early blocking off"
	fi
}

block_rules_clear() {
	[ -e "$BLOCK_RULES" ] || return 0
	block_rules_apply del < "$BLOCK_RULES"
	rm -f "$BLOCK_RULES"
}

# ---- checks ----
# True if the Ziti resolver answers at all, a refusal included.
resolver_answers() {
	local tmp rc
	tmp=$(mktemp) || return 1
	bounded "$tmp" "$(cfg_num watchdog_dns_timeout 3)" nslookup ziti-probe.invalid "$DNS_IP"
	grep -qE "can't find|^Name:|^Address" "$tmp"
	rc=$?
	rm -f "$tmp"
	return "$rc"
}

# A subnet stands for itself by its first address: under the fabric check, a failed
# dial to it proves as much as a connection.
first_host() {
	local ip="$1" prefix="$2" last
	last=${ip##*.}
	if [ "$prefix" -lt 31 ] && [ "$last" -lt 255 ]; then
		echo "${ip%.*}.$((last + 1))"
	else
		echo "$ip"
	fi
}

# Every address worth checking, one "address port" per line, TCP only: UDP confirms
# nothing. Names stay names until picked. Parsing costs several processes per address,
# so the result is kept until the services change.
refresh_probe_pool() {
	local status="$1" sum svc low high port addr host ip prefix i
	sum=$(jsonfilter -i "$status" -e '@.Data.Identities[@.Active=true].Services[*]' 2>/dev/null | sort | md5sum)
	[ -e "$PROBE_POOL" ] && [ "$sum" = "$(cat "$PROBE_POOL.sum" 2>/dev/null)" ] && return 0
	jsonfilter -i "$status" -e '@.Data.Identities[@.Active=true].Services[*]' 2>/dev/null | while IFS= read -r svc; do
		printf '%s' "$svc" | jsonfilter -e '@.Protocols[*]' | grep -qx tcp || continue
		low=$(printf '%s' "$svc" | jsonfilter -e '@.Ports[0].Low')
		high=$(printf '%s' "$svc" | jsonfilter -e '@.Ports[0].High')
		port=$low
		[ "${low:-1}" -le 443 ] && [ "${high:-0}" -ge 443 ] && port=443
		[ -n "$port" ] || port=443
		i=0
		while addr=$(printf '%s' "$svc" | jsonfilter -e "@.Addresses[$i]" 2>/dev/null) && [ -n "$addr" ]; do
			i=$((i+1))
			host=$(printf '%s' "$addr" | jsonfilter -e '@.HostName' 2>/dev/null)
			if [ -n "$host" ]; then
				case "$host" in \**) continue ;; esac
				echo "$host $port"
				continue
			fi
			ip=$(printf '%s' "$addr" | jsonfilter -e '@.IP' 2>/dev/null)
			prefix=$(printf '%s' "$addr" | jsonfilter -e '@.Prefix' 2>/dev/null)
			is_ipv4 "$ip" && echo "$(first_host "$ip" "${prefix:-32}") $port"
		done
	done | sort -u > "$PROBE_POOL"
	echo "$sum" > "$PROBE_POOL.sum"
}

# Up to $1 random lines of stdin, a new choice on every call.
pick_random() {
	awk -v n="$1" -v seed="$(cut -d' ' -f1 /proc/uptime | tr -d .)" '
		BEGIN { srand(seed) }
		{ line[NR] = $0 }
		END {
			for (i = NR; i > 0 && n > 0; i--) {
				j = int(rand() * i) + 1
				print line[j]
				line[j] = line[i]
				n--
			}
		}'
}

explicit_targets() {
	local p
	for p in $(cfg_list watchdog_probes ""); do
		case "$p" in
			*:*) echo "${p%:*} ${p##*:}" ;;
			*)   echo "$p 443" ;;
		esac
	done
}

# Addresses for one check: the ones set by hand, or else random ones from the services.
probe_targets() {
	local count
	count=$(cfg_num watchdog_probe_count 3)
	if [ -n "$(explicit_targets)" ]; then
		explicit_targets | pick_random "$count"
	else
		pick_random "$count" < "$PROBE_POOL"
	fi
}

# The whole line: a reason can repeat word for word, and only the time tells them apart.
last_failure() { logread -e ziti-edge-tunnel -l 300 2>/dev/null | grep 'reason=' | tail -n 1; }

# Classify the longest matching IPv4 prefix in main for $1: tunnel, other, or default.
# default includes no matching route. Other policy routing rules are not checked.
route_kind() {
	ip -4 route show table main match "$1" 2>/dev/null | awk '
		BEGIN { best = -1 }
		{
			p = $1
			if (p ~ /^(unreachable|blackhole|prohibit|throw)$/) p = $2
			len = p == "default" ? 0 : (p ~ /\//) ? substr(p, index(p, "/") + 1) + 0 : 32
			if (len > best) { best = len; tun = / dev ziti0( |$)/ }
		}
		END { print (tun ? "tunnel" : best > 0 ? "other" : "default") }'
}

# The tunneler answers a TCP connect only after the fabric dial succeeds, so a connection
# proves the whole path. A refusal from the target or a service without terminators
# still proves the fabric: it carried the dial and reported back. Reads "host port"
# lines and prints ok, alive, failed, no-routes or skipped.
# TCP probes bind to ziti0, so they can pass even when its route is missing from main.
# Resolve targets first and check their longest matching IPv4 prefixes in main.
# A non-tunnel default route or no match returns no-routes before any TCP attempts.
# Other specific routes are skipped; skipped is returned if none remain to probe.
# TCP attempts run in parallel, so a dead fabric costs one timeout, not one per address.
# The first successful connection ends the check and stops the remaining attempts.
probe_all() {
	local limit fifo before after host port ip r list="" skipped=0 pids="" n=0 result=failed
	limit=$(cfg_num watchdog_timeout 12)
	while read -r host port; do
		ip=$(resolve_v4 "$host" "$DNS_IP" | head -n 1)
		[ -n "$ip" ] || continue
		case $(route_kind "$ip") in
			tunnel)  list="$list $ip $port" ;;
			default) echo no-routes; return ;;
			*)       skipped=1 ;;
		esac
	done
	if [ -z "$list" ] && [ "$skipped" = 1 ]; then echo skipped; return; fi
	fifo=$(mktemp -u) && mkfifo -m 600 "$fifo" || { echo failed; return; }
	exec 3<>"$fifo"
	rm -f "$fifo"
	before=$(last_failure)
	# shellcheck disable=SC2086
	set -- $list
	while [ "$#" -ge 2 ]; do
		ip=$1 port=$2
		shift 2
		# Only the connect time matters: the service may not speak HTTP. One that stays
		# silent is dropped a second after the connect, not at the timeout.
		curl -s -o /dev/null --connect-timeout "$limit" -m "$limit" -y 1 -Y 1 --interface ziti0 \
			-w '%{time_connect}\n' "http://$ip:$port/" >&3 2>/dev/null &
		pids="$pids $!"
		n=$((n + 1))
	done
	# BusyBox ash has read -t, in whole seconds.
	# shellcheck disable=SC3045
	while [ "$n" -gt 0 ] && read -r -t "$((limit + 2))" r <&3; do
		n=$((n - 1))
		case "$r" in ''|0|0.000000) ;; *) result=ok; break ;; esac
	done
	# shellcheck disable=SC2086
	[ -z "$pids" ] || { kill $pids 2>/dev/null; wait $pids 2>/dev/null; }
	exec 3<&-
	if [ "$result" != ok ]; then
		after=$(last_failure)
		if [ "$after" != "$before" ]; then
			case "${after#*reason=}" in
				*"error creating route"*dial*|*refused*|*terminator*) result=alive ;;
			esac
		fi
	fi
	echo "$result"
}

# Prints the health of the tunnel as one state word, and leaves service and fabric names cached.
tunnel_health() {
	local status dump auth=0 conn=0 targets limit r passed=0 strict=0
	status=$(mktemp) && dump=$(mktemp) || { echo healthy; return; }
	limit=$(cfg_status_timeout)
	if ! bounded "$status" "$limit" "$ZET" tunnel_status || ! bounded "$dump" "$limit" "$ZET" dump; then
		rm -f "$status" "$dump"
		echo hung
		return
	fi
	remember_fabric_names "$dump"
	# Every identity turned off: nothing is wrong, and nothing can be checked.
	if ! jsonfilter -i "$status" -e '@.Data.Identities[@.Active=true].Name' 2>/dev/null | grep -q .; then
		rm -f "$status" "$dump"
		echo no-services
		return
	fi
	grep -q 'auth_state\[FullyAuthenticated\]' "$dump" && auth=1
	grep -q 'connected\[Y\]' "$dump" && conn=1
	if [ "$auth" != 1 ] || [ "$conn" != 1 ]; then
		rm -f "$status" "$dump"
		wan_up && echo no-connection || echo no-internet
		return
	fi
	# Only an authenticated tunnel knows its services.
	if ! jsonfilter -i "$status" -e '@.Data.Identities[@.Active=true].Services[*].Name' 2>/dev/null | grep -q .; then
		rm -f "$status" "$dump"
		echo no-services
		return
	fi
	remember_service_names "$status"
	remember_service_prefixes
	refresh_probe_pool "$status"
	rm -f "$status" "$dump"
	# Addresses set by hand stand for a resource that must work, so only a real answer counts.
	[ -n "$(explicit_targets)" ] && strict=1
	targets=$(probe_targets)
	if [ -n "$targets" ]; then
		r=$(echo "$targets" | probe_all)
		[ "$r" = no-routes ] && { echo no-routes; return; }
		if [ "$r" = ok ] || [ "$r" = skipped ] || { [ "$r" = alive ] && [ "$strict" = 0 ]; }; then passed=1; fi
		if [ "$passed" = 0 ]; then
			wan_up && echo no-data || echo no-internet
			return
		fi
	fi
	echo healthy
}

# True if a public address answers outside the tunnel.
wan_up() {
	local dev p limit
	dev=$(ip route show table main default | awk '{for (i=1;i<NF;i++) if ($i=="dev") {print $(i+1); exit}}')
	[ -n "$dev" ] || return 1
	limit=$(cfg_num watchdog_wan_timeout 3)
	for p in $(cfg_wan_probes); do
		curl -s -k -m "$limit" --interface "$dev" -o /dev/null "https://$p/" 2>/dev/null && return 0
	done
	return 1
}

in_grace() {
	local started now
	started=$(cat "$START_MARK" 2>/dev/null) || return 1
	now=$(date +%s)
	[ $((now - ${started:-0})) -lt "$(cfg_num watchdog_grace 15)" ]
}

# ---- watchdog ----
# Pauses before restarts without connection or while frozen. The last one repeats.
RESTART_STEP=0
NEXT_RESTART=0
restart_delay() {
	local i=0 d last=30
	for d in $(cfg_list watchdog_restart_delays "30 120 600 1800"); do
		case "$d" in ''|*[!0-9]*) continue ;; esac
		last=$d
		[ "$i" = "$1" ] && break
		i=$((i + 1))
	done
	echo "$last"
}

restart_due() {
	local now
	now=$(date +%s)
	[ "$NEXT_RESTART" = 0 ] && { NEXT_RESTART=$((now + $(restart_delay 0))); return 1; }
	[ "$now" -ge "$NEXT_RESTART" ] || return 1
	RESTART_STEP=$((RESTART_STEP + 1))
	NEXT_RESTART=$((now + $(restart_delay "$RESTART_STEP")))
}

restart_tunnel() {
	log "restarting the tunnel: $1"
	"$INIT" restart >/dev/null 2>&1
}

# Started, and Stop was not pressed. With the process gone, it crashed.
tunnel_wanted() { [ -e "$START_MARK" ] && [ ! -e "$STOP_MARK" ] && [ -n "$(list_identities)" ]; }

cmd_watchdog() {
	local interval fails recover health bad=0 good=0
	log "watchdog started"
	bypass_active && log "bypass already enabled; waiting for tunnel recovery"
	while true; do
		interval=$(cfg_num watchdog_interval 5)
		fails=$(cfg_num watchdog_fails 3)
		recover=$(cfg_num watchdog_recover 2)
		fabric_dns_sync
		firewall_sync
		block_rules_sync

		# The state is written before the changes: a dnsmasq restart takes a few seconds.
		if ! tunnel_running; then
			if [ -z "$(list_identities)" ]; then set_state no-identities
			elif tunnel_wanted; then set_state crashed
			else set_state stopped; fi
			# The tun device and its routes are gone with the process, and traffic to services
			# would go directly until procd starts it again. Blocking holds it back meanwhile.
			# Stop, by hand, is the user's choice and lifts the blocking.
			if tunnel_wanted && cfg_enabled && cfg_block; then
				bypass_on crashed
			else
				bypass_off
			fi
			dns_sync 0
			RESTART_STEP=0
			NEXT_RESTART=0
			bad=0
			good=0
		elif ! cfg_enabled; then
			set_state unchecked
			bypass_off
			resolver_answers && dns_sync 1 || dns_sync 0
		elif in_grace; then
			set_state starting
		else
			health=$(tunnel_health)
			if [ "$health" = healthy ]; then
				bad=0
				good=$((good + 1))
				RESTART_STEP=0
				NEXT_RESTART=0
				if [ "$good" -ge "$recover" ]; then
					set_state healthy
					bypass_off
					resolver_answers && dns_sync 1 || dns_sync 0
				elif ! bypass_active; then
					set_state healthy
				fi
			else
				good=0
				bad=$((bad + 1))
				if [ "$health" = hung ] || [ "$bad" -ge "$fails" ]; then
					set_state "$health"
					bypass_on "$health"
					dns_sync 0
				fi
				# Restart after the configured pause to reload missing tunnel routes.
				case "$health" in
					no-connection|hung|no-routes) restart_due && restart_tunnel "$health" ;;
				esac
			fi
			# The WAN gateway can change while the bypass is on.
			bypass_active && [ "$health" != healthy ] && bypass_on "$health"
		fi
		sleep "$interval"
	done
}

# ---- identities ----
# Control characters are dropped: JSON does not allow them raw.
json_str() { printf '%s' "$1" | tr -d '\000-\037' | sed 's/\\/\\\\/g; s/"/\\"/g'; }

# Prints a JSON array. The runtime file keeps names and on/off across stops.
identities_json() {
	local status dump f id name active st first=1 running=0 file_status ctrl block
	status=$(mktemp) && dump=$(mktemp) || { echo '[]'; return; }
	if tunnel_running; then
		running=1
		bounded "$status" "$(cfg_status_timeout)" "$ZET" tunnel_status || : > "$status"
		bounded "$dump" "$(cfg_status_timeout)" "$ZET" dump || : > "$dump"
	fi
	printf '['
	for f in "$IDENT_DIR"/*.json; do
		[ -e "$f" ] || continue
		[ "$f" = "$RUNTIME" ] && continue
		id=$(basename "$f" .json)
		file_status="$status"
		[ -s "$file_status" ] && name=$(jsonfilter -i "$file_status" -e "@.Data.Identities[@.Identifier=\"$f\"].Name" 2>/dev/null) || name=
		[ -n "$name" ] || name=$(jsonfilter -i "$RUNTIME" -e "@.Identities[@.Identifier=\"$f\"].Name" 2>/dev/null)
		active=$(jsonfilter -i "$RUNTIME" -e "@.Identities[@.Identifier=\"$f\"].Active" 2>/dev/null)
		[ -s "$file_status" ] && active=$(jsonfilter -i "$file_status" -e "@.Data.Identities[@.Identifier=\"$f\"].Active" 2>/dev/null)
		ctrl=$(jsonfilter -i "$f" -e '@.ztAPI' 2>/dev/null)
		if [ "$active" = false ]; then
			st=disabled
		elif [ "$running" != 1 ]; then
			st=stopped
		else
			# The dump holds one text block per identity, in a JSON string.
			block=$(jsonfilter -i "$dump" -e "@.Data[\"$f\"]" 2>/dev/null)
			case "$block" in
				*'auth_state[FullyAuthenticated]'*'connected[Y]'*) st=active ;;
				*) st=no-connection ;;
			esac
		fi
		[ "$first" = 1 ] || printf ','
		first=0
		printf '{"id":"%s","name":"%s","file":"%s","enabled":%s,"controller":"%s","status":"%s"}' \
			"$(json_str "$id")" "$(json_str "${name:-$id}")" "$(json_str "$f")" \
			"$([ "$active" = false ] && echo false || echo true)" "$(json_str "$ctrl")" "$st"
	done
	printf ']\n'
	rm -f "$status" "$dump"
}

list_identities() {
	local f
	for f in "$IDENT_DIR"/*.json; do
		[ -e "$f" ] && [ "$f" != "$RUNTIME" ] && echo "$f"
	done
}

valid_id() { case "$1" in *[!A-Za-z0-9_.-]*|""|config) return 1 ;; esac; }

# Why an enrollment failed, as one word. An unknown failure adds the tunneler's last line.
enroll_failure() {
	case "$(cat "$1")" in
		*ENROLLMENT_EXPIRED*) echo token-expired ;;
		*ALREADY_ENROLLED*) echo token-used ;;
		*INVALID_ENROLLMENT_TOKEN*|*"JWT not accepted"*) echo token-invalid ;;
		*"lacks a"*|*"invalid format"*|*"json parse error"*) echo token-format ;;
		*CONTROLLER_UNAVAILABLE*|*"controller is not available"*) echo no-controller ;;
		*) echo "other $(grep -v '^$' "$1" | tail -n 1 | sed 's/^([0-9]*)\[[ 0-9.]*\] *//')" ;;
	esac
}

cmd_enroll() {
	local jwt="$1" id out logf
	# The process id keeps two enrollments in the same second apart.
	id="identity-$(date +%s)-$$"
	out="$IDENT_DIR/$id.json"
	logf=/tmp/ziti-enroll.$$.log
	if ! "$ZET" enroll --jwt "$jwt" --identity "$out" >"$logf" 2>&1 || [ ! -s "$out" ]; then
		rm -f "$out"
		enroll_failure "$logf"
		rm -f "$logf"
		return 1
	fi
	rm -f "$logf"
	chmod 0600 "$out"
	# The tunneler reads the identity directory only when it starts.
	"$INIT" restart >/dev/null 2>&1
	echo "$id"
}

cmd_identity_set() {
	local f on=f
	valid_id "$1" || return 2
	f="$IDENT_DIR/$1.json"
	[ -e "$f" ] || return 2
	[ "$2" = 1 ] && on=t
	"$ZET" on_off_identity -i "$f" -o "$on" >/dev/null 2>&1
}

cmd_identity_remove() {
	local f
	valid_id "$1" || return 2
	f="$IDENT_DIR/$1.json"
	[ -e "$f" ] || return 2
	tunnel_running && "$ZET" delete -i "$f" >/dev/null 2>&1
	rm -f "$f" "$f.bak"
}

# ---- install ----
zone_exists() { uci -q show firewall | grep -q "\.name='ziti'"; }

own_forwardings() { uci -q show firewall | sed -n "s/^firewall\.\(${FORWARDING}[A-Za-z0-9_]*\)=forwarding\$/\1/p"; }

# True if a forwarding from zone $1 into ziti exists, the user's own included.
forwarding_exists() {
	local s
	for s in $(uci -q show firewall | sed -n 's/^firewall\.\([^.=]*\)=forwarding$/\1/p'); do
		[ "$(uci -q get "firewall.$s.src")" = "$1" ] && [ "$(uci -q get "firewall.$s.dest")" = ziti ] && return 0
	done
	return 1
}

# Forwardings into ziti from the zones in source_zones. A zone that does not exist is
# skipped, and a forwarding the user made is left alone. Runs on every check, so a
# changed setting applies without a restart.
firewall_sync() {
	local z s want changed=0
	want=" $(cfg_zones) "
	zone_exists || return 0
	for z in $want; do
		case "$z" in *[!A-Za-z0-9_]*) continue ;; esac
		s="$FORWARDING$z"
		uci -q get "firewall.$s" >/dev/null && continue
		uci -q show firewall | grep -q "\.name='$z'\$" || continue
		forwarding_exists "$z" && continue
		uci set "firewall.$s=forwarding"
		uci set "firewall.$s.src=$z"
		uci set "firewall.$s.dest=ziti"
		changed=1
	done
	for s in $(own_forwardings); do
		case "$want" in *" ${s#"$FORWARDING"} "*) continue ;; esac
		uci -q delete "firewall.$s"
		changed=1
	done
	[ "$changed" = 1 ] || return 0
	uci commit firewall
	/etc/init.d/firewall reload >/dev/null 2>&1
	log "forwarding into ziti from zones: $(own_forwardings | sed "s/^$FORWARDING//" | tr '\n' ' ')"
}

cmd_setup() {
	local changed=0
	if ! zone_exists; then
		uci set "firewall.$ZONE=zone"
		uci set "firewall.$ZONE.name=ziti"
		uci add_list "firewall.$ZONE.device=ziti0"
		uci set "firewall.$ZONE.input=REJECT"
		uci set "firewall.$ZONE.output=ACCEPT"
		uci set "firewall.$ZONE.forward=REJECT"
		uci set "firewall.$ZONE.masq=1"
		uci set "firewall.$ZONE.mtu_fix=1"
		changed=1
	fi
	if [ "$changed" = 1 ]; then
		uci commit firewall
		/etc/init.d/firewall reload >/dev/null 2>&1
	fi
	firewall_sync
	dns_sync 0
	fabric_dns_sync
}

cmd_uninstall() {
	bypass_off
	block_rules_clear
	block_names 0
	fabric_dns_off
	dns_restore
	local s
	for s in $(own_forwardings); do
		uci -q delete "firewall.$s"
	done
	uci -q delete "firewall.$ZONE"
	uci commit firewall
	/etc/init.d/firewall reload >/dev/null 2>&1
	rm -f "$SERVICE_NAMES" "$SERVICE_PREFIXES" "$PROBE_POOL" "$PROBE_POOL.sum" "$FABRIC_NAMES"
}

# For a look at what the watchdog would check. A status file stands in for the live tunnel.
cmd_probes() {
	local status="${1:-}" tmp=""
	if [ -z "$status" ]; then
		tmp=$(mktemp) || return 1
		status=$tmp
		bounded "$status" "$(cfg_status_timeout)" "$ZET" tunnel_status || { rm -f "$tmp"; return 1; }
	fi
	refresh_probe_pool "$status"
	echo "pool: $(wc -l < "$PROBE_POOL")"
	probe_targets
	[ -z "$tmp" ] || rm -f "$tmp"
}

# A check already under way may overwrite the file after Stop or Restart, so the marks win.
current_state() {
	if [ -e "$STOP_MARK" ]; then echo stopped
	elif in_grace; then echo starting
	else cat "$STATE_FILE" 2>/dev/null || echo starting; fi
}

# ---- entry point ----
case "${1:-}" in
	watchdog)        cmd_watchdog ;;
	state)           printf '{"state":"%s","bypass":%s}\n' "$(current_state)" \
	                     "$(bypass_active && echo true || echo false)" ;;
	probes)          cmd_probes "${2:-}" ;;
	identities)      identities_json ;;
	enroll)          cmd_enroll "${2:?jwt file}" ;;
	identity-set)    cmd_identity_set "${2:?id}" "${3:?0 or 1}" ;;
	identity-remove) cmd_identity_remove "${2:?id}" ;;
	setup)           cmd_setup ;;
	uninstall)       cmd_uninstall ;;
	*) echo "usage: ziti-boot-guard {watchdog|state|probes|identities|enroll|identity-set|identity-remove|setup|uninstall}" >&2; exit 2 ;;
esac

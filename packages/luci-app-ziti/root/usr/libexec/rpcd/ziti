#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
#
# rpcd backend for luci-app-ziti.
#
# Implements the JSON-stdin/stdout protocol expected by /usr/sbin/rpcd:
#
#   $0 list                -> prints a JSON object describing methods
#   $0 call <method>       -> reads JSON args from stdin, prints JSON result
#
# Methods are listed at the bottom of this file. enroll receives the raw JWT, keeps
# it in a private file under a root-only directory, and always removes that file.
# enroll, check_update and upgrade_zet answer at once and run in the background;
# job_status gives their answer.

set -u

ZET_BIN="/usr/bin/ziti-edge-tunnel"
GUARD="/usr/libexec/ziti-boot-guard"
INIT="/etc/init.d/ziti-edge-tunnel"
JWT_STAGE_DIR="/var/run/ziti-jwt"
JOB_DIR="/var/run/ziti-job"

# ---------- helpers ----------

json_escape() {
	# Minimal JSON string escape for shell-built strings.
	awk 'BEGIN{
		s=""
		while ((getline line) > 0) {
			if (s != "") s = s "\\n"
			gsub(/\\/, "\\\\", line)
			gsub(/"/, "\\\"", line)
			gsub(/\t/, "\\t", line)
			gsub(/\r/, "", line)
			s = s line
		}
		print s
	}'
}

emit_error() {
	# emit_error "code" "message"
	printf '{"error":{"code":"%s","message":"%s"}}\n' "$1" "$2"
}

# ---------- background jobs ----------
# LuCI gives up on a request after 20 seconds, and enrollment or an upgrade can take
# longer. One job runs at a time; its JSON answer stays until the next one starts.

# A written result means the job is done: without procd to reap it, as in a container,
# the finished process lingers as a zombie, and kill -0 still finds it.
job_running() {
	[ ! -e "$JOB_DIR/result" ] && [ -s "$JOB_DIR/pid" ] && kill -0 "$(cat "$JOB_DIR/pid")" 2>/dev/null
}

# job_start <name> <function> [args...]
job_start() {
	local name="$1"
	shift
	if job_running; then
		emit_error "busy" "$(cat "$JOB_DIR/name" 2>/dev/null)"
		return 1
	fi
	mkdir -p "$JOB_DIR"
	chmod 0700 "$JOB_DIR"
	rm -f "$JOB_DIR/result"
	echo "$name" > "$JOB_DIR/name"
	( "$@" > "$JOB_DIR/result.new" 2>/dev/null; mv "$JOB_DIR/result.new" "$JOB_DIR/result" ) \
		</dev/null >/dev/null 2>&1 &
	echo "$!" > "$JOB_DIR/pid"
	printf '{"ok":true,"job":"%s"}\n' "$name"
}

method_job_status() {
	local name
	name=$(cat "$JOB_DIR/name" 2>/dev/null)
	if job_running; then
		printf '{"running":true,"job":"%s"}\n' "$name"
	elif [ -s "$JOB_DIR/result" ]; then
		printf '{"running":false,"job":"%s","result":%s}\n' "$name" "$(cat "$JOB_DIR/result")"
	else
		printf '{"running":false,"job":"%s"}\n' "$name"
	fi
}

# ---------- methods ----------

method_status() {
	local running=false autostart=false version="" state
	pidof ziti-edge-tunnel >/dev/null 2>&1 && running=true
	"$INIT" enabled 2>/dev/null && autostart=true
	version="$("$ZET_BIN" version 2>/dev/null | head -n1 | tr -d '\r\n')"
	# The binary prints the build's git version twice: v1.2.3.v1.2.3.
	version="${version%%.v*}"
	state=$("$GUARD" state | jsonfilter -e '@.state')
	printf '{"running":%s,"autostart":%s,"version":"%s","state":"%s"}\n' \
		"$running" "$autostart" "$version" "$state"
}

method_list_identities() {
	printf '{"identities":%s}\n' "$("$GUARD" identities)"
}

method_enroll() {
	local args jwt jwt_file
	args="$(cat)"
	jwt=$(printf '%s' "$args" | jsonfilter -e '@.jwt' 2>/dev/null)
	if [ -z "$jwt" ]; then
		emit_error "invalid_args" "jwt required"
		return
	fi

	# A private directory in RAM: JWTs are one-time secrets, and a file left behind by a
	# killed call stays out of flash and backups and is gone after a reboot.
	mkdir -p "$JWT_STAGE_DIR"
	chmod 0700 "$JWT_STAGE_DIR"
	# With no job running, any token here is left from a job that was killed.
	job_running || rm -f "$JWT_STAGE_DIR"/jwt.*
	jwt_file="$(mktemp -p "$JWT_STAGE_DIR" jwt.XXXXXX)" || {
		emit_error "io_error" "cannot create staging file"
		return
	}
	printf '%s' "$jwt" > "$jwt_file"
	job_start enroll do_enroll "$jwt_file" || rm -f "$jwt_file"
}

# The job owns the token file and removes it however enrollment ends.
do_enroll() {
	local out rc code message=""
	out=$("$GUARD" enroll "$1")
	rc=$?
	rm -f "$1"
	if [ "$rc" -ne 0 ]; then
		# The guard prints a reason word, followed by text only for an unknown failure.
		code=${out%% *}
		[ "$code" = "$out" ] || message=${out#* }
		emit_error "$code" "$(printf '%s' "$message" | json_escape)"
		return
	fi
	printf '{"ok":true,"id":"%s"}\n' "$out"
}

method_set_identity() {
	local args id en on=0
	args="$(cat)"
	id=$(printf '%s' "$args" | jsonfilter -e '@.id' 2>/dev/null)
	en=$(printf '%s' "$args" | jsonfilter -e '@.enabled' 2>/dev/null)
	{ [ "$en" = "true" ] || [ "$en" = "1" ]; } && on=1
	if "$GUARD" identity-set "$id" "$on"; then
		printf '{"ok":true}\n'
	else
		emit_error "set_failed" "cannot change identity; is the tunnel running?"
	fi
}

method_remove_identity() {
	local args id
	args="$(cat)"
	id=$(printf '%s' "$args" | jsonfilter -e '@.id' 2>/dev/null)
	if "$GUARD" identity-remove "$id"; then
		printf '{"ok":true}\n'
	else
		emit_error "not_found" "no such identity"
	fi
}

method_set_autostart() {
	local en
	en=$(jsonfilter -e '@.enabled' 2>/dev/null)
	if [ "$en" = "true" ] || [ "$en" = "1" ]; then
		"$INIT" enable >/dev/null 2>&1
	else
		"$INIT" disable >/dev/null 2>&1
	fi
	printf '{"ok":true}\n'
}

method_service_action() {
	local args action
	args="$(cat)"
	action=$(printf '%s' "$args" | jsonfilter -e '@.action' 2>/dev/null)
	case "$action" in
		start|stop|restart) ;;
		*) emit_error "invalid_args" "bad action"; return;;
	esac
	"$INIT" "$action" >/dev/null 2>&1
	printf '{"ok":true,"action":"%s"}\n' "$action"
}

# ---------- updates (signed feed, verified by apk) ----------

_oz_feed_url() {
	sed -n '/^[^#]/{p;q;}' /etc/apk/repositories.d/openwrt-ziti-stack.list 2>/dev/null
}

# Print the newest version from `apk list` lines such as
# "ziti-edge-tunnel-1.18.7-r7 aarch64_cortex-a53 {...} (...) [installed]".
# apk lists every version it knows, the installed one included, in no useful order.
_oz_version() {
	local v best=""
	for v in $(sed -n 's/^ziti-edge-tunnel-\([^ ]*\) .*/\1/p'); do
		{ [ -z "$best" ] || [ "$(apk version -t "$v" "$best")" = ">" ]; } && best=$v
	done
	echo "$best"
}

# True if version $1 is newer than $2, or $2 is empty.
_oz_newer() { [ -n "$1" ] && { [ -z "$2" ] || [ "$(apk version -t "$1" "$2")" = ">" ]; }; }

# `apk policy` lists each known version with the repositories that have it. These print
# the versions in the project feed, or in any other repository, as `apk list` lines.
_oz_feed_versions() {
	[ -n "$1" ] || return 0
	apk policy ziti-edge-tunnel 2>/dev/null | awk -v f="$1" '
		/^  [^ ]/ { v = $1; sub(/:$/, "", v); next }
		$1 == f { print "ziti-edge-tunnel-" v " " }'
}
_oz_other_versions() {
	apk policy ziti-edge-tunnel 2>/dev/null | awk -v f="$1" '
		/^  [^ ]/ { v = $1; sub(/:$/, "", v); next }
		/^    / && $1 != f && $1 !~ /installed$/ { print "ziti-edge-tunnel-" v " " }'
}

# apk verifies the index signature against /etc/apk/keys itself, but an untrusted
# index is only a warning: the update still exits 0 and the index is ignored.
_oz_update_feed() {
	local out
	out=$(apk update 2>&1) || return 1
	case "$out" in *UNTRUSTED*) return 1 ;; esac
}

# Sets INSTALLED, CANDIDATE (newest in the project feed) and OTHER (a newer version in
# another repository, which apk would install instead, so nothing is offered then).
_oz_versions() {
	local feed="$1"
	INSTALLED=$(apk list -I ziti-edge-tunnel 2>/dev/null | _oz_version)
	CANDIDATE=$(_oz_feed_versions "$feed" | _oz_version)
	OTHER=$(_oz_other_versions "$feed" | _oz_version)
	_oz_newer "$OTHER" "${CANDIDATE:-$INSTALLED}" || OTHER=""
}

method_check_update() { job_start check do_check; }

do_check() {
	local feed upgradable=false
	feed=$(_oz_feed_url)
	if ! _oz_update_feed; then
		emit_error "update_failed" "apk update failed; check the network and the feed signing key"
		return
	fi
	_oz_versions "$feed"
	[ -z "$OTHER" ] && _oz_newer "$CANDIDATE" "$INSTALLED" && upgradable=true
	printf '{"installed":"%s","candidate":"%s","other":"%s","feed":"%s","verified":true,"upgradable":%s}\n' \
		"$INSTALLED" "$CANDIDATE" "$OTHER" "$feed" "$upgradable"
}

method_upgrade_zet() { job_start upgrade do_upgrade; }

do_upgrade() {
	if ! _oz_update_feed; then
		emit_error "update_failed" "apk update failed; check the network and the feed signing key"
		return
	fi
	local out rc v
	_oz_versions "$(_oz_feed_url)"
	if [ -n "$OTHER" ] || ! _oz_newer "$CANDIDATE" "$INSTALLED"; then
		emit_error "no_update" "no newer version in the project feed"
		return
	fi
	out=$(apk add --upgrade ziti-edge-tunnel 2>&1); rc=$?
	if [ $rc -ne 0 ]; then
		emit_error "install_failed" "$(printf '%s' "$out" | json_escape)"
		return
	fi
	/etc/init.d/ziti-edge-tunnel restart >/dev/null 2>&1
	v=$(apk list -I ziti-edge-tunnel 2>/dev/null | _oz_version)
	printf '{"ok":true,"version":"%s"}\n' "$v"
}

# ---------- dispatch ----------

case "${1:-}" in
	list)
		cat <<'EOF'
{
	"status":           { },
	"list_identities":  { },
	"enroll":           { "jwt": "" },
	"set_identity":     { "id": "", "enabled": false },
	"remove_identity":  { "id": "" },
	"service_action":   { "action": "" },
	"set_autostart":    { "enabled": false },
	"check_update":     { },
	"upgrade_zet":      { },
	"job_status":       { }
}
EOF
		;;
	call)
		case "${2:-}" in
			status)          method_status ;;
			list_identities) method_list_identities ;;
			enroll)          method_enroll ;;
			set_identity)    method_set_identity ;;
			remove_identity) method_remove_identity ;;
			service_action)  method_service_action ;;
			set_autostart)   method_set_autostart ;;
			check_update)    method_check_update ;;
			upgrade_zet)     method_upgrade_zet ;;
			job_status)      method_job_status ;;
			*)               emit_error "no_method" "unknown method" ;;
		esac
		;;
	*)
		emit_error "usage" "expected: list | call <method>"
		;;
esac

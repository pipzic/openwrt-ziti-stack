#
# OpenZiti UCI config. Unset options use the default shown here.
#

config ziti 'main'
	option log_level 'INFO'
	# Firewall zones whose traffic may enter the tunnel.
	# list source_zones 'lan'
	# Watchdog: checks the tunnel and sends traffic around it while it is broken.
	# option watchdog_enabled '1'
	# option watchdog_interval '5'
	# option watchdog_fails '3'
	# option watchdog_recover '2'
	# option watchdog_timeout '12'
	# option watchdog_grace '15'
	# Each check tries this many random service addresses. One answer from the fabric is
	# enough, even from a service that is down.
	# option watchdog_probe_count '3'
	# Checked outside the tunnel, to tell a lost internet connection from a fabric failure.
	# list watchdog_wan_probes '1.1.1.1'
	# list watchdog_wan_probes '8.8.8.8'
	# list watchdog_wan_probes '9.9.9.9'
	# list watchdog_wan_probes '208.67.222.222'
	# Resources that must accept a connection, as address[:port] or name[:port], port 443 if
	# omitted. When set, they replace the addresses from the services.
	# list watchdog_probes '192.0.2.10:443'
	# Delays before restarts without connection or while frozen. The last one repeats.
	# list watchdog_restart_delays '30'
	# list watchdog_restart_delays '120'
	# list watchdog_restart_delays '600'
	# list watchdog_restart_delays '1800'
	# Seconds to wait for the tunnel's state, for an internet check address, and for DNS.
	# option watchdog_status_timeout '4'
	# option watchdog_wan_timeout '3'
	# option watchdog_dns_timeout '3'
	# With the watchdog on, block cached service addresses and names during bypass,
	# including after an unexpected process exit. Stop lifts the blocking.
	# Installed rules prevent source-zone traffic to cached non-default service prefixes
	# from falling back to less specific routes before the next check.
	# option block_on_failure '0'
	# Routing table and rule priority of the bypass. Exceptions use tables bypass_table + 1
	# and + 2 and priorities bypass_priority - 6 to - 1; blocking rules use + 1 and + 2.
	# Choose tables and priorities not used by other packages.
	# A pending or saved allocation keeps its values until reboot or successful uninstall
	# and reallocation.
	# option bypass_table '1890'
	# option bypass_priority '100'
	# Exceptions. Controllers and routers of this OpenZiti network found in source zones
	# bypass the tunnel completely.
	# option direct_fabric '1'
	# Addresses or subnets that bypass the tunnel completely.
	# list direct_sources '192.168.1.10'
	# Addresses or subnets that use the tunnel only for services.
	# list services_sources '192.168.1.0/24'
	# Connection mark bit for connections from WAN. Choose a bit not used by other software.
	# A pending or saved allocation keeps its value until reboot or successful uninstall
	# and reallocation.
	# option reply_mark '0x20000000'
	# Seconds from the end of a lookup round to the next round, and the maximum age
	# of a cached host entry since its last confirmation.
	# option fabric_refresh '300'
	# option fabric_stale '3600'

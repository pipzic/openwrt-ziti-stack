--- a/src/http.c
+++ b/src/http.c
@@ -18,6 +18,12 @@
 #include <stdlib.h>
 #include <string.h>

+#if !defined(_WIN32)
+#include <netinet/in.h>
+#include <netinet/tcp.h>
+#include <sys/socket.h>

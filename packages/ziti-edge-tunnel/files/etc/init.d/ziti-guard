#!/bin/sh /etc/rc.common
# Copyright (C) 2026 OpenZiti contributors
# Apache-2.0
#
# Runs the watchdog loop as its own procd service, separate from ziti-edge-tunnel, so
# restarting the tunnel cannot kill it. procd respawns it if it ever dies. It idles
# while the tunnel is stopped, so it stays enabled whatever the tunnel's autostart is.

START=99
STOP=10
USE_PROCD=1

GUARD=/usr/libexec/ziti-boot-guard

start_service() {
	[ -x "$GUARD" ] || return 0
	procd_open_instance ziti-guard
	procd_set_param command "$GUARD" watchdog
	procd_set_param respawn 3600 5 0
	# Allow the loop to finish its current step; procd forces termination after this timeout.
	procd_set_param term_timeout 60
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

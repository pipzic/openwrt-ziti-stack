{
	"luci-app-ziti": {
		"description": "Grant access to manage OpenZiti via LuCI",
		"read": {
			"ubus": {
				"ziti": [ "status", "list_identities", "check_update", "job_status" ]
			},
			"uci": [ "ziti" ]
		},
		"write": {
			"ubus": {
				"ziti": [ "enroll", "set_identity", "remove_identity", "service_action", "set_autostart", "upgrade_zet" ]
			},
			"uci": [ "ziti" ]
		}
	}
}
